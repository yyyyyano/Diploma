{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "/home/user/University/CLAUDE.md"
  ],
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge --ff-only *)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make test-*)",
      "Bash(make fmt)",
      "Bash(make deps-check)",
      "Bash(make db-up)",
      "Bash(make ai-record *)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(make e2e)",
      "Bash(make check-quick)",
      "Bash(make check-full)",
      "Bash(make check-commits)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(./samples/**)",
      "Edit(./samples/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/readonly-bash.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-writes.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|fixer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-impl.sh",
            "args": [],
            "timeout": 900,
            "statusMessage": "Гейт: make check и чистое дерево"
          }
        ]
      }
    ]
  }
}
