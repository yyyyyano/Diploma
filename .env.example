# Переменные окружения «Кошта». `make init` копирует этот файл в .env, только если .env ещё нет.
#
# Правила (.claude/rules/docker-tooling.md, NFR-16):
# - каждая переменная — с безопасным значением по умолчанию и комментарием «что это и зачем»;
# - новую переменную добавляет та задача, которая её вводит, вместе со схемой конфигурации
#   (apps/server/src/platform/config, T-005) — переменных «на будущее» здесь нет;
# - секреты (мастер-ключ, пароль БД) сюда не пишутся: они лежат в secrets/ вне git;
# - .env в git не попадает, в git только этот файл.

# ── База данных (compose.yaml, apps/server/src/platform/db) ──
# Порт Postgres на хосте; сервис db публикуется только на 127.0.0.1 (ADR-0015).
DB_PORT=5440
# Факты машины для Compose (ADR-0015; make init пишет значения этой машины): группа render — доступ моделей к
# iGPU (/dev/dri), APP_UID/APP_GID — пользователь контейнеров приложения (читает secrets/, пишет data/).
RENDER_GID=992
APP_UID=1000
APP_GID=1000
# Две роли одной базы (ADR-0020): хост, порт и база обоих адресов совпадают, порт — с DB_PORT; пароля в адресе нет.
# Адрес базы для приложения и тестов — роль kosht_app без административных прав (только чтение и запись строк).
DATABASE_URL=postgres://kosht_app@127.0.0.1:5440/kosht
# Файл пароля роли приложения (NFR-16, создаёт make init): в режиме «код на хосте» — secrets/db_app_password.
DB_PASSWORD_FILE=secrets/db_app_password
# Адрес владельца базы (POSTGRES_USER из compose.yaml): миграции и выдача прав роли приложения при старте.
MIGRATION_DATABASE_URL=postgres://kosht@127.0.0.1:5440/kosht
# Файл пароля владельца (тот же, что у Compose): в режиме «код на хосте» — secrets/db_password.
MIGRATION_DB_PASSWORD_FILE=secrets/db_password
# Папка миграций Drizzle, которые приложение применяет при старте; в образе — /app/drizzle.
MIGRATIONS_DIR=apps/server/drizzle

# ── Сервер (apps/server/src/platform/config) ──
# Локальный слушатель (NFR-24, R40): только этот компьютер; первый запуск и почтовый ящик живут только на нём.
LISTEN_LOCAL_HOST=127.0.0.1
LISTEN_LOCAL_PORT=8140
# Сетевой слушатель: доступ с других устройств, открывается настройкой в админке (по умолчанию закрыт).
LISTEN_LAN_HOST=0.0.0.0
LISTEN_LAN_PORT=8141
# Дополнительные origin для изменяющих запросов, через запятую (http(s)://хост[:порт]); обычно пусто.
TRUSTED_ORIGINS=
# Собранный сайт, который отдаёт сервер (статика и маршруты сайта); в make dev сайт отдаёт Vite.
WEB_DIST_DIR=apps/web/dist
# Корень данных запуска: data/logs (логи), data/files (файлы пользователей); вне git.
DATA_DIR=data
# Мастер-ключ секретов (32 случайных байта, создаёт make init; вне git и вне резервной копии).
MASTER_KEY_FILE=secrets/master.key
# Уровень логов: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# ── Трассы ИИ: Langfuse (ADR-0010, профиль Compose observability) ──
# Langfuse включён по умолчанию (OBS-05); false — трассы не пишутся, приложение работает как прежде.
LANGFUSE_ENABLED=true
# Адрес Langfuse: интерфейс разработчика и приём трасс; в контейнерах приложения — http://langfuse-web:3000.
LANGFUSE_BASE_URL=http://127.0.0.1:3001
# Ключи проекта Langfuse (создаёт make init; вне git). Нет файлов — трассы выключены с предупреждением в логе.
LANGFUSE_PUBLIC_KEY_FILE=secrets/langfuse_public_key
LANGFUSE_SECRET_KEY_FILE=secrets/langfuse_secret_key

# ── Настройки и секреты (platform/settings, platform/secrets) ──
# Задаются в админке; переменная здесь — запасное значение разработчика (админка важнее, NFR-16). По умолчанию не
# заданы — раскомментируйте нужную. Ключи API и токены сюда кладутся только в .env, не в этот файл.
# Часовой пояс системы (NFR-23); по умолчанию Europe/Minsk.
# TIME_ZONE=Europe/Minsk
# Почта (AUTH-06): пока SMTP_HOST пуст, все письма попадают в локальный ящик /mailbox (только этот компьютер).
# SMTP_HOST=smtp.example.by
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_FROM=no-reply@kosht.local
# Пароль SMTP — секрет: только в .env (SMTP_PASSWORD=…) или в админке.
# ИИ-провайдеры (T-023, ADM-50): ключи облачных моделей — секреты, только в .env или в админке («Провайдеры ИИ»).
# Ключ из админки важнее. Без ключа провайдер не участвует в цепочке; пользователи без облачного согласия
# работают только на локальных моделях.
# GROQ_API_KEY=
# ZAI_API_KEY=
# Адрес llama-server (локальные модели, OpenAI-совместимый API); в контейнерах приложения — http://llama:8080/v1.
# LLAMA_BASE_URL=http://127.0.0.1:8142/v1
# Адрес whisper-server (whisper.cpp, голос на сайте и в боте); в контейнерах приложения — http://whisper:8080.
# WHISPER_BASE_URL=http://127.0.0.1:8143
# Сроки первого куска ответа модели, мс: облачной (30 с) и локальной (5 мин — на процессоре ответ идёт долго).
# Скачивание локальных моделей после первого запуска и из админки (NFR-25); 0 — выключено (тесты, стенд e2e).
# LLM_MODELS_DOWNLOAD=1
# LLM_TIMEOUT_CLOUD_MS=30000
# LLM_TIMEOUT_LOCAL_MS=300000
# Правовая база (LAW-10, LAW-35…38): автозагрузка стартового каталога после первого запуска (0 — выключено: тесты, стенд
# e2e); источник текстов — pravo.by или сохранённые страницы из LEGAL_FIXTURES_DIR (тесты, NFR-11); контакт оператора
# загрузчика — email или адрес сайта для User-Agent (по умолчанию его задаёт экран первого запуска, дальше — админка).
# LEGAL_BASE_AUTOLOAD=1
# LEGAL_SOURCE=pravo-by
# LEGAL_FIXTURES_DIR=
# LEGAL_LOADER_CONTACT=
# Сколько дней хранятся журнал расхода ИИ (90) и трассы Langfuse (30); чистят ночные задачи.
# LLM_USAGE_RETENTION_DAYS=90
# LLM_TRACE_RETENTION_DAYS=30
