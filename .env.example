# Переменные окружения «Кошта». `make init` копирует этот файл в .env, только если .env ещё нет.
#
# Правила (.claude/rules/docker-tooling.md, NFR-16):
# - каждая переменная — с безопасным значением по умолчанию и комментарием «что это и зачем»;
# - новую переменную добавляет та задача, которая её вводит, вместе со схемой конфигурации
#   (apps/server/src/platform/config, T-005) — переменных «на будущее» здесь нет;
# - секреты (мастер-ключ, пароль БД) сюда не пишутся: они лежат в secrets/ вне git;
# - .env в git не попадает, в git только этот файл.

# ── База данных (compose.yaml, apps/server/src/platform/db) ──
# Порт Postgres на хосте; сервис db публикуется только на 127.0.0.1 (ADR-0015).
DB_PORT=5440
# Адрес базы для приложения, миграций и тестов — без пароля: пароль приложение читает из файла
# secrets/db_password (его создаёт make init). Порт здесь должен совпадать с DB_PORT.
DATABASE_URL=postgres://kosht@127.0.0.1:5440/kosht
# Файл пароля БД (NFR-16): в режиме «код на хосте» — secrets/db_password, в контейнере — /run/secrets/db_password.
DB_PASSWORD_FILE=secrets/db_password

# ── Сервер (apps/server/src/platform/config) ──
# Локальный слушатель (NFR-24, R40): только этот компьютер; первый запуск и почтовый ящик живут только на нём.
LISTEN_LOCAL_HOST=127.0.0.1
LISTEN_LOCAL_PORT=8140
# Сетевой слушатель: доступ с других устройств, открывается настройкой в админке (по умолчанию закрыт).
LISTEN_LAN_HOST=0.0.0.0
LISTEN_LAN_PORT=8141
# Дополнительные origin для изменяющих запросов, через запятую (http(s)://хост[:порт]); обычно пусто.
TRUSTED_ORIGINS=
# Корень данных запуска: data/logs (логи), data/files (файлы пользователей); вне git.
DATA_DIR=data
# Мастер-ключ секретов (32 случайных байта, создаёт make init; вне git и вне резервной копии).
MASTER_KEY_FILE=secrets/master.key
# Уровень логов: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
